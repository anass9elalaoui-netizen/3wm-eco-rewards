# ── Database ──
# For local dev (SQLite): DATABASE_URL="file:./dev.db"
# For production (MySQL/Hostinger): DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"
DATABASE_URL="mysql://user:password@localhost:3306/3wmdb"

# ── Gas Tank Wallet ──
# Dedicated wallet with ~5$ BNB for merchant checkout JIT gas fees
# This is NOT the admin/treasury wallet — it only funds gas for custodial user transactions
GAS_TANK_PRIVATE_KEY="your_gas_tank_private_key_here"

# ── IMPORTANT: BYOK Architecture ──
# The master treasury private key is NOT stored here.
# The executive admin injects it via the Admin Dashboard UI at runtime.
# This is by design for maximum security (Bring Your Own Key pattern).

# ── Privy Authentication ──
# Frontend: Public App ID (safe to expose to client)
NEXT_PUBLIC_PRIVY_APP_ID="your_privy_app_id_here"
# Backend: App Secret (NEVER expose to client — gives full backend access)
PRIVY_APP_SECRET="your_privy_app_secret_here"

