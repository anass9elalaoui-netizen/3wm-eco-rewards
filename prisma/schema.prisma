datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
}

model EcoAction {
  id               String   @id @default(cuid())
  fullName         String
  age              String
  phoneNumber      String   @unique
  photoUrl         String
  walletAddress    String?
  encryptedPrivKey String?  @db.Text
  rewardAmount     Int?
  status           String   @default("PENDING")
  slug             String?  @unique
  createdAt        DateTime @default(now())
}

model Ambassador {
  id          String   @id @default(cuid())
  fullName    String
  role        String   @default("Ambassadeur")
  phoneNumber String   @unique
  photoUrl    String
  slug        String   @unique
  status      String   @default("PENDING") // PENDING, APPROVED
  createdAt   DateTime @default(now())
}
